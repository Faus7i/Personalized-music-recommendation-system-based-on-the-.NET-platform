@page "/"
@inject UserSessionState Session
@inject CatalogApiClient CatalogApiClient
@inject PlayerState PlayerState
@inject LibraryState LibraryState
@inject PreferenceState PreferenceState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>首页 - SonicCanvas</PageTitle>

<section class="hero-banner">
    <div>
        <h1>把推荐系统做成真正可交互的音乐平台</h1>
        <p class="hero-copy">
            登录后即可创建歌单、标记喜欢/不喜欢、打开歌曲详情，并在底部播放器里试听整个平台的推荐内容。
        </p>
    </div>
    <div class="hero-banner-actions">
        @if (!Session.IsAuthenticated)
        {
            <a class="pill-button primary-pill" href="register">立即注册</a>
            <a class="pill-button ghost-pill" href="login">已有账号去登录</a>
        }
        else
        {
            <button class="pill-button primary-pill" @onclick="RefreshSongsAsync">刷新推荐</button>
            <a class="pill-button ghost-pill" href="cold-start">继续完善偏好</a>
        }
    </div>
</section>

@if (!Session.IsReady)
{
    <div class="loading-container">
        <div class="loading-spinner"></div>
        <p>正在恢复你的会话状态...</p>
    </div>
}
else if (!Session.IsAuthenticated)
{
    <section class="welcome-grid">
        <article class="welcome-card">
            <span>账户体系</span>
            <h2>登录、注册、注销统一在顶部完成</h2>
            <p>未登录显示登录/注册，登录后切换为头像与注销按钮，适合毕业设计展示完整账号流程。</p>
        </article>
        <article class="welcome-card">
            <span>个性化推荐</span>
            <h2>喜欢与不喜欢直接驱动推荐池</h2>
            <p>推荐服务会结合你的反馈调整得分，优先推送更相关的歌曲与创作者。</p>
        </article>
        <article class="welcome-card">
            <span>歌单与播放</span>
            <h2>左侧歌单、右侧详情、底部播放器统一联动</h2>
            <p>不仅能收藏到自建歌单，还能在同一工作台中查看详情和播放预览。</p>
        </article>
    </section>
}
else if (isLoading)
{
    <div class="loading-container">
        <div class="loading-spinner"></div>
        <p>正在从 Spotify 获取最新推荐歌曲...</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert-error">
        <span class="alert-icon">⚠</span>
        @errorMessage
    </div>
}
else
{
    <section class="dashboard-section">
        <div class="section-headline">
            <div>
                <h2>为你推荐</h2>
                <p>实时从 Spotify 在线曲库中随机推荐 @songs.Count 首歌曲</p>
            </div>
            <button class="pill-button ghost-pill" @onclick="RefreshSongsAsync">换一批</button>
        </div>

        @if (songs.Any())
        {
            <div class="track-grid">
                @foreach (var song in songs)
                {
                    <MusicTrackCard Song="@song"
                                    ShowPreferenceActions="true"
                                    ShowPlayButton="true"
                                    OnOpenDetails="OpenDetailsAsync"
                                    OnPlay='async value => await PlaySongAsync(value)'
                                    OnLike='async value => await SubmitPreferenceAsync(value, "like")'
                                    OnDislike='async value => await SubmitPreferenceAsync(value, "dislike")' />
                }
            </div>

            @if (showPlayModal)
            {
                <div class="modal-overlay" @onclick="ClosePlayModal">
                    <div class="modal-content" @onclick:stopPropagation="true">
                        <h3>选择播放方式</h3>
                        <p>@selectedSong?.Title - @selectedSong?.Artist</p>
                        <div class="modal-actions">
                            <button class="pill-button primary-pill" @onclick="PlayPreview">播放预览音频</button>
                            <button class="pill-button" @onclick="OpenSpotify">在 Spotify 中播放</button>
                            <button class="pill-button ghost-pill" @onclick="ClosePlayModal">取消</button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <p>暂无推荐内容，请检查 Spotify 连接后点击"换一批"重试</p>
            </div>
        }
    </section>
}

@code {
    private List<SongCardDto> songs = [];
    private string? errorMessage;
    private bool isLoading;
    private bool showPlayModal;
    private SongCardDto? selectedSong;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        LibraryState.Changed += OnLibraryChanged;
        await LoadSongsAsync();
    }

    private void OnSessionChanged() => _ = InvokeAsync(LoadSongsAsync);
    private void OnLibraryChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task LoadSongsAsync()
    {
        songs = [];
        errorMessage = null;

        if (!Session.IsAuthenticated)
        {
            StateHasChanged();
            return;
        }

        isLoading = true;

        try
        {
            songs = (await CatalogApiClient.GetColdStartSongsAsync(20)).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshSongsAsync()
    {
        await LoadSongsAsync();
    }

    private async Task SubmitPreferenceAsync(SongCardDto song, string feedbackType)
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            SongCardDto savedSong;

            if (song.Id == Guid.Empty)
            {
                savedSong = await CatalogApiClient.EnsureSpotifyTrackAsync(new EnsureSpotifyTrackRequest(
                    song.SpotifyUri?.Split(':').LastOrDefault() ?? string.Empty,
                    song.Genre,
                    song.SpotifyUri,
                    song.Title,
                    song.Artist,
                    song.Album,
                    song.AudioUrl,
                    song.CoverUrl,
                    song.ExternalUrl,
                    song.DurationSeconds,
                    (int)song.PopularityScore,
                    song.ReleaseDate?.ToString("yyyy-MM-dd")));
            }
            else
            {
                savedSong = song;
            }

            var result = await CatalogApiClient.SubmitPreferenceAsync(new SubmitSongPreferenceRequest(
                Session.CurrentUser!.UserId,
                savedSong.Id,
                feedbackType,
                "home"));

            PreferenceState.Apply(result);
            songs.Remove(song);
            LibraryState.NotifyChanged();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            StateHasChanged();
        }
    }

    private async Task PlaySongAsync(SongCardDto song)
    {
        SongDetailsDto details;
        if (song.Id == Guid.Empty)
        {
            details = new SongDetailsDto(
                song.Id,
                song.Title,
                song.Artist,
                song.Album,
                song.Genre,
                song.TempoTag,
                song.MoodTag,
                song.EnergyLevel,
                song.SpotifyUri,
                song.ExternalUrl,
                song.CoverUrl,
                song.AudioUrl,
                song.ReleaseDate,
                song.DurationSeconds,
                song.PopularityScore,
                "Spotify 实时推荐歌曲");
        }
        else
        {
            details = await CatalogApiClient.GetSongDetailsAsync(song.Id);
        }

        if (details is not null)
        {
            PlayerState.Play(details);
        }
    }

    private async Task OpenDetailsAsync(SongCardDto song)
    {
        try
        {
            SongCardDto savedSong = song;

            if (song.Id == Guid.Empty)
            {
                savedSong = await CatalogApiClient.EnsureSpotifyTrackAsync(new EnsureSpotifyTrackRequest(
                    song.SpotifyUri?.Split(':').LastOrDefault() ?? string.Empty,
                    song.Genre,
                    song.SpotifyUri,
                    song.Title,
                    song.Artist,
                    song.Album,
                    song.AudioUrl,
                    song.CoverUrl,
                    song.ExternalUrl,
                    song.DurationSeconds,
                    (int)song.PopularityScore,
                    song.ReleaseDate?.ToString("yyyy-MM-dd")));
            }

            var details = await CatalogApiClient.GetSongDetailsAsync(savedSong.Id);
            if (details is not null)
            {
                PlayerState.OpenDetails(details);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            StateHasChanged();
        }
    }

    private async Task PlayPreview()
    {
        if (selectedSong != null && !string.IsNullOrWhiteSpace(selectedSong.AudioUrl))
        {
            await JSRuntime.InvokeVoidAsync("playAudio", selectedSong.AudioUrl);
        }
        ClosePlayModal();
    }

    private async Task OpenSpotify()
    {
        if (selectedSong != null && !string.IsNullOrWhiteSpace(selectedSong.ExternalUrl))
        {
            await JSRuntime.InvokeVoidAsync("open", selectedSong.ExternalUrl, "_blank");
        }
        ClosePlayModal();
    }

    private void ClosePlayModal()
    {
        showPlayModal = false;
        selectedSong = null;
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        LibraryState.Changed -= OnLibraryChanged;
    }
}
